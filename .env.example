# =============================================================================
# Frebrico – Environment variables
# Copy this file to .env and fill in your values. Do not commit .env.
# =============================================================================

# -----------------------------------------------------------------------------
# Backend (Node / server)
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3001
DB_PATH=./data/frebrico.db
UPLOADS_DIR=./public/uploads

# Secret for signing JWT tokens (auth). Set a long random string in production.
JWT_SECRET=

# When backend is in Docker and frontend is local (yarn dev), allow that origin (e.g. http://localhost:5173).
# Comma-separated for multiple. Leave empty when frontend is same-origin (e.g. full Docker).
ALLOW_ORIGIN=

# When backend runs in Docker and frontend runs locally (yarn dev), set:
#   VITE_API_BASE=http://localhost:3002
#   ALLOW_ORIGIN=http://localhost:5173
# Then: docker compose up backend -d  and  yarn dev
# -----------------------------------------------------------------------------
# Frontend (Vite) – only VITE_* are exposed to the browser
# -----------------------------------------------------------------------------
# Leave empty to use same-origin /api (dev proxy or production nginx).
# Backend in Docker + frontend yarn dev: use http://localhost:3002
VITE_API_BASE=

# Public site URL for SEO (canonical, Open Graph, Twitter).
VITE_BASE_URL=https://www.frebrico.com

# Default image for social sharing (og:image, twitter:image).
VITE_OG_IMAGE=https://www.frebrico.com/og-image.jpg
