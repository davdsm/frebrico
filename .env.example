# =============================================================================
# Frebrico – Environment variables
# Copy this file to .env and fill in your values. Do not commit .env.
# =============================================================================

# -----------------------------------------------------------------------------
# Backend (Node / server)
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3001
DB_PATH=./data/frebrico.db
UPLOADS_DIR=./public/uploads

# Secret for signing JWT tokens (auth). Set a long random string in production.
JWT_SECRET=

# When backend is in Docker and frontend is local (yarn dev), allow that origin (e.g. http://localhost:5173).
# Comma-separated for multiple. Leave empty when frontend is same-origin (e.g. full Docker).
ALLOW_ORIGIN=

# When backend runs in Docker and frontend runs locally (yarn dev), set:
#   VITE_API_BASE=http://localhost:3002
#   ALLOW_ORIGIN=http://localhost:5173
# Then: docker compose up backend -d  and  yarn dev
# -----------------------------------------------------------------------------
# Frontend (Vite) – only VITE_* are exposed to the browser
# -----------------------------------------------------------------------------
# Leave empty to use same-origin /api (Vite dev/preview proxy in Docker or local dev).
# Backend in Docker + frontend yarn dev: use http://localhost:3002
VITE_API_BASE=

# Public site URL for SEO (canonical, Open Graph, Twitter).
VITE_BASE_URL=https://www.frebrico.com

# Default image for social sharing (og:image, twitter:image).
VITE_OG_IMAGE=https://www.frebrico.com/og-image.jpg

# -----------------------------------------------------------------------------
# Production server (Docker)
# -----------------------------------------------------------------------------
# On the server: copy this file to .env, set JWT_SECRET and VITE_BASE_URL, then:
#   yarn prod:deploy
# Leave VITE_API_BASE empty so Vite preview proxies /api to the backend container.
#
# Host ports already taken on the server (Traefik, other stacks): 80, 443, 3000, 3002, 4000, 8080.
# Frebrico uses 3002 for the API (localhost only) and 4173 for the site (Vite preview) — both outside 80/443.
# Point Traefik at 127.0.0.1:4173 (or set FRONTEND_PORT to another free port).
FRONTEND_PORT=4173
#
# Backend API: 127.0.0.1:3002 only (not public). Do not use 3000, 4000, or 8080 for Frebrico.
# Persistent data: ./data and ./data/uploads (mounted into the backend container).

# -----------------------------------------------------------------------------
# Email (SMTP via Nodemailer)
# -----------------------------------------------------------------------------
# Fill these to enable transactional emails (order confirmations, contact form).
# Leave empty to run without email (emails will be logged to console only).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=info@frebrico.pt
MAIL_FROM_NAME=Frebrico
MAIL_ADMIN=info@frebrico.pt
